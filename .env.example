# Servidor
NODE_ENV=production
PORT=5000

# Banco de dados local Atenza
# Padrao: PostgreSQL local via Docker, banco unico por ambiente e schema por projeto.
DATABASE_URL=postgresql://postgres:troque-a-senha@127.0.0.1:5432/atenza_local
PGSCHEMA=smartdocplan

# Autenticacao
# Segredo para assinar tokens JWT de sessao (minimo 32 caracteres).
JWT_SECRET=troque-por-uma-string-segura-de-pelo-menos-32-chars

# Storage opcional
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=

# LLM opcional
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# OPENAI_API_KEY=
